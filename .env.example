# Configure live market and LLM prediction access for the Traders Prediction page
VITE_TWELVEDATA_API_KEY=6a849f0c58884b8eb8c639958401fe70

# Optional: OpenAI key for LLM-generated prediction output
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Backend-only Angel One credentials (do not prefix these with VITE_)
ANGELONE_PRIVATE_KEY=your_angelone_private_key
ANGELONE_CLIENT_LOCAL_IP=127.0.0.1
ANGELONE_CLIENT_PUBLIC_IP=your_public_ip
ANGELONE_MAC_ADDRESS=your_mac_address

# Optional: custom LLM API URL if you want to use a different endpoint
# VITE_OPENAI_API_URL=https://your-llm-endpoint.example.com/v1/chat/completions
