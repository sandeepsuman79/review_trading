# Angel One credentials and connection settings
VITE_ANGELONE_API_KEY=your_angelone_api_key

# Backend-only Angel One credentials (do not prefix these with VITE_)
ANGELONE_PRIVATE_KEY=your_angelone_private_key
ANGELONE_CLIENT_LOCAL_IP=127.0.0.1
ANGELONE_CLIENT_PUBLIC_IP=your_public_ip
ANGELONE_MAC_ADDRESS=your_mac_address

# Optional Gemini AI candle commentary (backend only; never use the VITE_ prefix)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
