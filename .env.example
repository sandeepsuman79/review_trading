# Angel One credentials and connection settings
VITE_ANGELONE_API_KEY=your_angelone_api_key

# Backend-only Angel One credentials (do not prefix these with VITE_)
ANGELONE_PRIVATE_KEY=your_angelone_private_key
ANGELONE_CLIENT_LOCAL_IP=127.0.0.1
ANGELONE_CLIENT_PUBLIC_IP=your_public_ip
ANGELONE_MAC_ADDRESS=your_mac_address

# Optional Gemini AI candle commentary (backend only; never use the VITE_ prefix)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Public market context uses free news/constituent feeds; no additional API key.
# News assessments are cached/shared. Gemini chart commentary is manual and optional.
# Download the optional local financial-text classifier once with npm run news:setup.
# auto loads cached model files offline; off disables local inference.
# Text-only sentiment is labelled separately and excluded from market-impact scores.
NEWS_LOCAL_CLASSIFIER=auto
