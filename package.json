{
  "name": "review-wala",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:analysis": "node --test tests/priceAction.test.cjs tests/tradingEvidence.test.cjs",
    "test:indicators": "node --test tests/chartIndicators.test.cjs tests/indiaVix.test.cjs",
    "test:stream": "node --test tests/liveCandles.test.cjs",
    "test:context": "node --test tests/marketContext.test.js",
    "test:dashboard": "node --test tests/marketInputs.test.js tests/marketDashboard.test.cjs tests/newsEvidence.test.cjs",
    "test:history": "node --test tests/predictionHistory.test.cjs",
    "news:setup": "node server/setupLocalNews.js",
    "test:ai": "node --test tests/aiResilience.test.js"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "apexcharts": "^5.16.0",
    "fast-xml-parser": "^5.11.2",
    "react": "^18.2.0",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.2"
  },
  "overrides": {
    "onnxruntime-node": "1.21.0",
    "global-agent": "^4.1.3",
    "adm-zip": "^0.6.0"
  }
}
